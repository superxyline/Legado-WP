<Page
    x:Class="legado_wp.Views.ReplacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Padding="8,10">
            <Button Content="←" Click="OnBackClick" VerticalAlignment="Center"/>
            <TextBlock Text="替换净化规则" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button Content="＋新增" Margin="12,0,0,0" Click="OnAddClick" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="Hint" Grid.Row="1" Text="净化规则按顺序套用于正文与章节标题&#x0a;作用域填书名或书源片段，空 = 全部生效"
                   Foreground="Gray" FontSize="12" Padding="12,0,0,6"/>

        <ListView x:Name="RuleList" Grid.Row="2" Padding="8" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEditClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="Gray"
                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Checked="OnToggle" Unchecked="OnToggle" Margin="8,0" Content=""/>
                        <Button Grid.Column="2" Content="删除" FontSize="12" Background="Transparent"
                                Click="OnDeleteClick"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" TextAlignment="Center" Text="暂无净化规则&#x0a;点上方「＋新增」创建"/>
    </Grid>
</Page>
