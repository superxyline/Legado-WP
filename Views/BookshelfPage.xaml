<Page
    x:Class="legado_wp.Views.BookshelfPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="ShelfList" IsItemClickEnabled="True" ItemClick="OnBookClick" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,8" Holding="OnBookHolding" RightTapped="OnBookRightTapped">
                        <StackPanel.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="移出书架" Click="OnRemoveMenu"/>
                            </MenuFlyout>
                        </StackPanel.ContextFlyout>
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock FontSize="13" Foreground="Gray">
                            <Run Text="{Binding Author}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding LastChapter}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint" Text="书架空空如也&#x0a;点下方「搜索」找一本书加入吧" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Foreground="Gray" FontSize="15"/>

        <CommandBar Grid.Row="1" VerticalAlignment="Bottom">
            <AppBarButton Label="搜索" Icon="Find" Click="OnSearchClick"/>
            <AppBarButton Label="书源" Icon="Library" Click="OnSourcesClick"/>
            <AppBarButton Label="备份" Icon="Save" Click="OnBackupClick"/>
            <AppBarButton Label="恢复" Icon="OpenFile" Click="OnRestoreClick"/>
            <AppBarButton Label="净化" Icon="Highlight" Click="OnReplaceClick"/>
            <AppBarButton Label="自检" Icon="Setting" Click="OnProbeClick"/>
        </CommandBar>
    </Grid>
</Page>
