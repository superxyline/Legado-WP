<Page
    x:Class="legado_wp.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <CaptureElement x:Name="Preview" Stretch="UniformToFill"/>

        <!-- 取景框 -->
        <Border x:Name="ScanFrame" Width="280" Height="280" BorderBrush="#80FFFFFF"
                BorderThickness="2" CornerRadius="8" HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        <TextBlock x:Name="Hint" Text="对准书源二维码&#x0a;自动识别后导入"
                   Foreground="White" FontSize="16" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,140"/>

        <TextBlock x:Name="Status" Text="" Foreground="#90FFFFFF" FontSize="13"
                   TextAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,90"/>

        <Button x:Name="CloseBtn" Content="✕ 取消" Foreground="White" FontSize="16"
                Background="#66000000" HorizontalAlignment="Center"
                VerticalAlignment="Bottom" Margin="0,0,0,30" Click="OnCloseClick"/>
    </Grid>
</Page>
