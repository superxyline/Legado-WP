<Page
    x:Class="legado_wp.Views.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8,10">
            <Button Content="←" Click="OnBackClick" VerticalAlignment="Center"/>
            <TextBlock Text="书源管理" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="ManageBtn" Content="管理" Margin="12,0,0,0" FontSize="13"
                    Click="OnManageClick" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 多选管理操作栏（管理模式可见） -->
        <StackPanel x:Name="ManageBar" Grid.Row="1" Orientation="Horizontal" Padding="8,0,8,4" Visibility="Collapsed">
            <Button Content="全选" FontSize="12" Click="OnSelectAllClick"/>
            <Button Content="反选" FontSize="12" Margin="8,0,0,0" Click="OnInvertClick"/>
            <Button Content="启用" FontSize="12" Margin="8,0,0,0" Click="OnBatchEnableClick"/>
            <Button Content="禁用" FontSize="12" Margin="8,0,0,0" Click="OnBatchDisableClick"/>
            <Button Content="校验" FontSize="12" Margin="8,0,0,0" Click="OnCheckClick"/>
            <Button Content="删除所选" FontSize="12" Margin="8,0,0,0" Click="OnBatchDeleteClick"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Padding="8,0,8,8">
            <TextBox x:Name="UrlBox" PlaceholderText="书源 JSON 的 URL" Width="200"/>
            <Button Content="导入" Margin="8,0,0,0" Click="OnImportClick"/>
            <Button Content="扫码导入" Margin="8,0,0,0" Click="OnScanClick"/>
        </StackPanel>

        <ListView x:Name="SourceList" Grid.Row="3" Padding="8" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding BookSourceName}" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding BookSourceUrl}" FontSize="11" Foreground="Gray"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Checked="OnToggle" Unchecked="OnToggle" Margin="8,0"/>
                        <Button Grid.Column="2" Content="变量" FontSize="12" Background="Transparent"
                                Click="OnVariableClick"/>
                        <Button Grid.Column="3" Content="删除" FontSize="12" Background="Transparent"
                                Click="OnDeleteClick"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusHint" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Gray" TextAlignment="Center" Text="暂无书源&#x0a;粘贴书源 URL 导入"/>
    </Grid>
</Page>
